---
import BaseLayout from '../layouts/BaseLayout.astro';
import Skyline from '../components/Skyline.astro';
import { projects, site } from '../data/site';
---
<BaseLayout>
  <Skyline slot="banner" />
  <header>
    <h1>{site.title}</h1>
    <p class="bio">
      Building <a href="https://tigerteamapp.com">TigerTeamApp.com</a><span class="cursor" aria-hidden="true"></span>
    </p>
  </header>

  <hr class="rule" />

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul class="projects">
      {projects.map((project) => (
        <li>
          <a class="project-preview" href={project.live ?? project.repo}>
            <img src={project.preview} alt={project.previewAlt} width="832" height="468" loading="lazy" decoding="async" />
          </a>
          <p class="title">
            <a class="name" href={project.repo ?? project.live}>{project.name}</a>
            {project.live && project.repo && (
              <>
                <span class="sep" aria-hidden="true">/</span>
                <a class="aux" href={project.live} aria-label={`Open ${project.name}`}>{project.name === 'asciicity' ? 'play' : 'open'}</a>
              </>
            )}
          </p>
          <p>{project.blurb}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
