      <path d="M12 2.6c3.6 0 6.4 2.7 6.4 6a6.1 6.1 0 0 1-1.9 4.4A6.6 6.6 0 0 1 12 15a6.6 6.6 0 0 1-4.5-2A6.1 6.1 0 0 1 5.6 8.6c0-3.3 2.8-6 6.4-6Z" stroke-width="1.5" />
    </>
  )}

  {name === 'spires' && (
    <>
      <path d="M3 21h18" stroke-width="1.7" />
