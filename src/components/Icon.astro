  )}

  {name === 'email' && (
    <>
      <rect x="2.6" y="4.9" width="18.8" height="14.2" rx="2.2" />
      <path d="m3.4 6.6 8.6 6 8.6-6" />
    </>
  )}

  {name === 'sun' && (
    <>
